# --- API Behavior ---
APIBEHAVIOR__SERVICENAME=Sery.API
APIBEHAVIOR__INCLUDEEXCEPTIONDETAILS=true

# --- Rate Limiting ---
RATELIMIT__FREETIERDAILYMESSAGELIMIT=30

# --- Database (Supabase/PostgreSQL) ---
# Tip: Keep the password and project-ref out of your code
CONNECTIONSTRINGS__DEFAULTCONNECTION="Host=aws-1-us-east-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.[YOUR_PROJECT_REF];Password=[YOUR_PASSWORD];SSL Mode=Require;Trust Server Certificate=true"

# --- OpenAI Integration ---
CHATAI__BASEURL=https://api.openai.com
CHATAI__MODEL=gpt-4o-mini
CHATAI__APIKEY=sk-your-openai-key-here
CHATAI__SYSTEMPROMPT="You are Sery, a supportive AI companion..."

# --- Observability & Logs ---
SERILOG__WRITETO__1__ARGS__SERVERURL=http://localhost:5341
LOGGING__LOGLEVEL__DEFAULT=Debug