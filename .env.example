# --- API Behavior ---
APIBEHAVIOR__SERVICENAME=Sery.API
APIBEHAVIOR__INCLUDEEXCEPTIONDETAILS=true

# --- Rate Limiting ---
RATELIMIT__FREETIERDAILYMESSAGELIMIT=30

# --- Database (Supabase/PostgreSQL) ---
# Runtime (API): Transaction pooler port 6543 — IPv4-friendly; app adds No Reset On Close for Npgsql.
# Optional override: CONNECTIONSTRINGS__RUNTIMECONNECTION=...
CONNECTIONSTRINGS__DEFAULTCONNECTION="Host=aws-1-us-east-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.[YOUR_PROJECT_REF];Password=[YOUR_PASSWORD];SSL Mode=Require;Trust Server Certificate=true"
# Migrations (`dotnet ef database update`): Session pooler :5432 (same host as transaction pooler, user postgres.<ref>) — IPv4-friendly. NOT port 6543.
# Direct db.<ref>.supabase.co:5432 often resolves to IPv6-only; skip if your network has no IPv6.
CONNECTIONSTRINGS__MIGRATIONCONNECTION="Host=aws-1-us-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.[YOUR_PROJECT_REF];Password=[YOUR_PASSWORD];SSL Mode=Require;Trust Server Certificate=true"
# Deprecated alias for MIGRATIONCONNECTION:
# CONNECTIONSTRINGS__DESIGNTIME=

# --- OpenAI Integration ---
CHATAI__BASEURL=https://api.openai.com
CHATAI__MODEL=gpt-4o-mini
CHATAI__APIKEY=sk-your-openai-key-here
CHATAI__SYSTEMPROMPT="You are Sery, a supportive AI companion..."

# --- Observability & Logs ---
# Each WriteTo index needs Name (and Args for sinks like Seq). Omit Seq lines if you do not run Seq locally.
SERILOG__WRITETO__0__NAME=Console
SERILOG__WRITETO__1__NAME=Seq
SERILOG__WRITETO__1__ARGS__SERVERURL=http://localhost:5341
LOGGING__LOGLEVEL__DEFAULT=Debug